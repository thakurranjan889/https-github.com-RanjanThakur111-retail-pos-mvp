rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep this value in sync with ADMIN_EMAIL in src/App.jsx.
    // The app displays admin access based on this same verified Google email.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'ranjan111790@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid;

      allow read: if signedIn() && (
        request.auth.uid == resource.data.customerUid || isAdmin()
      );

      allow update, delete: if isAdmin();
    }
  }
}
